# YUBI Supervision — environment template
# Copy to .env and adjust as needed: cp .env.example .env

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Webcam (server-side OpenCV capture)
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_TIMEOUT_SEC=12
# Default input source (the UI source box overrides this per-session).
# Leave blank for the webcam. Accepts:
#   - a webcam index            CAMERA_SOURCE=0
#   - a local video file        CAMERA_SOURCE=clips/traffic.mp4
#   - an RTSP / HTTP CCTV feed  CAMERA_SOURCE=rtsp://user:pass@10.0.0.5:554/stream1
#   - a YouTube URL (live streams via HLS; VOD clips download to cache)
#                             CAMERA_SOURCE=https://youtu.be/XXXXXXXXXXX
# CAMERA_SOURCE=
# Loop file/clip sources when they reach the end (continuous analysis feed).
# The Interview profile always plays files once so the session ends with a report.
SOURCE_LOOP=true
# Play files at 1x so overlays, media timestamps, and episode times track the video.
SOURCE_REALTIME_PACING=true
# Analysis profile when the UI/API does not choose one: general | interview | security
DEFAULT_PROFILE=general
# yt-dlp format selector used when resolving a YouTube/stream URL.
# YOUTUBE_FORMAT=best[ext=mp4][height<=1080]/best[height<=1080]/best
# YouTube VOD clips download here (live streams are not cached; deleted on Terminate).
# Default: $TMPDIR/yubi-supervision/youtube  (macOS: /var/folders/.../T/yubi-supervision/youtube)
# YOUTUBE_CACHE_DIR=
# Auto-delete cached clips older than this many hours (168 = 7 days; 0 = never).
# YOUTUBE_CACHE_MAX_AGE_HOURS=168

# Object detection
# yolov8n.pt = fastest, yolov8s.pt = better accuracy (default), yolov8m.pt = best/slowest
# Use a *-seg model (e.g. yolov8s-seg.pt) to enable the Masks layer (segmentation).
YOLO_MODEL=yolov8s.pt
YOLO_IMGSZ=640
YOLO_IOU=0.5
YOLO_MAX_DET=30
# Run YOLO every N frames (1 = every frame; higher = more FPS, slightly laggier boxes)
YOLO_STRIDE=2
DEFAULT_CONFIDENCE=0.35

# Inference downscale (1080p webcams often ignore CAMERA_WIDTH/HEIGHT — this caps processing size)
PROCESSING_MAX_WIDTH=1280
STREAM_JPEG_QUALITY=80
# Remote live (YouTube HLS, RTSP): MJPEG publisher vs inference cadence
LIVE_STREAM_FPS=20
LIVE_INFERENCE_FPS=2.0
LIVE_REMOTE_LITE=true

# Alerts (optional): comma-separated COCO labels + webhook
# ALERT_CLASSES=person,cell phone
# ALERT_WEBHOOK_URL=https://example.com/hook
ALERT_COOLDOWN_SEC=10

# Optional: override MediaPipe model directory
# MODELS_DIR=backend/models

# YUBI v3.0 intelligence layer (user-facing name; env prefix GEMINI_*)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_ENABLED=true
# Perception tier — scene boxes, label verification, identity (high volume, cheapest).
GEMINI_MODEL=gemini-3.5-flash-lite
# Reasoning tier — event-driven behavioral insights and the session report.
GEMINI_INSIGHT_MODEL=gemini-3.8-flash
# Image detail for perception calls: low | medium | high | auto (low ≈ 4x fewer image tokens).
GEMINI_MEDIA_RESOLUTION=low
# Scene passes are change-gated: at most one per GEMINI_INTERVAL_SEC while the view
# changes; an unchanged view backs off (x2 per refresh) up to GEMINI_MAX_INTERVAL_SEC.
GEMINI_INTERVAL_SEC=4
GEMINI_MAX_INTERVAL_SEC=60
# Mean pixel delta (0-255) on a 32x18 grayscale thumbnail that counts as a scene change.
GEMINI_SCENE_CHANGE_THRESHOLD=6
GEMINI_MAX_OBJECTS=8
GEMINI_ANALYSIS_SCALE=0.6
# Optional cap (0 = scale only)
GEMINI_ANALYSIS_MAX_WIDTH=0
GEMINI_JPEG_QUALITY=70
GEMINI_BOX_MAX_AGE_SEC=6
# Below this local confidence, v3.0 verifies or corrects the label (or suppresses noise).
GEMINI_VERIFY_BELOW=0.45
# How long a v3.0-confirmed label persists on a tracker without another API call.
GEMINI_LABEL_CACHE_SEC=45
# Post-session report: 1 = compose, 2 = analyze + compose, 3 = + evidence audit.
SESSION_REPORT_PASSES=2

# AI spend governor (shared by every YUBI v3.0 call in a session).
# Estimated USD cap per session (0 = unlimited). Report passes bypass the cap.
AI_SESSION_BUDGET_USD=1.0
AI_MAX_CALLS_PER_MIN=12
AI_REQUEST_TIMEOUT_SEC=30

# Behavioral insight engine — interprets locally detected episodes (text digest +
# a few apex face crops) instead of streaming video frames to the model.
INSIGHTS_ENABLED=true
# Minimum seconds between insight calls; a call only fires when there is new evidence.
INSIGHT_MIN_INTERVAL_SEC=20
# Without notable episodes, fold accumulated behavior into a digest at most this often.
INSIGHT_DIGEST_INTERVAL_SEC=90
# Apex face crops attached per insight call (0 = text only, cheapest).
INSIGHT_MAX_IMAGES=2
# Reasoning depth for insights: minimal | low | medium | high
INSIGHT_THINKING=low

# Local micro-expression engine (runs on-device; no API cost).
# Seconds of face time used to learn each subject's neutral baseline.
EXPRESSION_CALIBRATION_SEC=4
# >1 detects subtler movements (more episodes), <1 only stronger ones.
EXPRESSION_SENSITIVITY=1.0
# Experimental camera pulse estimate (rPPG) on the primary face.
EXPRESSION_PULSE_ENABLED=true

# Identity layer (YUBI v3.0 vision) — name / jersey number / descriptor per
# tracked person. Requires GEMINI_API_KEY. Toggle live via the "Identity" chip.
IDENTITY_ENABLED=true
IDENTITY_INTERVAL_SEC=4
IDENTITY_MAX_PERSONS=6
# How long a confirmed identity sticks on a tracker without re-querying.
IDENTITY_LABEL_CACHE_SEC=90

# Initial overlay layers (the UI can toggle these live once running).
SHOW_MASKS_DEFAULT=false
SHOW_POSE_LABELS_DEFAULT=false
SHOW_IDENTITY_DEFAULT=false
